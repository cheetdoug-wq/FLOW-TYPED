# Public origin of this app, with no trailing slash.
# The redirect URI registered in Google Cloud must be: {APP_URL}/api/auth/google/callback
APP_URL=http://localhost:3000

# Google Cloud > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the session cookie. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Needed for "Browse Google Drive" (Google Picker).
# API key restricted to the Google Picker API, with your site and https://docs.google.com/* as allowed referrers.
GOOGLE_PICKER_API_KEY=
# Cloud project NUMBER (not the project ID), from the Google Cloud dashboard.
GOOGLE_PROJECT_NUMBER=
